<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
  <Border Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
          TextElement.Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <StackPanel Margin="28" MaxWidth="1020" MinWidth="560" HorizontalAlignment="Stretch">
        <TextBlock Text="Android via Wi-Fi" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="Depuração sem cabos, no seu Visual Studio" Margin="0,5,0,24" Opacity="0.7" />
        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="6" Padding="18">
          <StackPanel>
            <TextBlock Text="01   Conecte o computador e o Android à mesma rede Wi-Fi" FontWeight="SemiBold" />
            <TextBlock Text="02   No Android 11 ou superior, ative Opções do desenvolvedor → Depuração sem fio" Margin="0,10,0,0" TextWrapping="Wrap" />
            <TextBlock Text="O aparelho aparecerá nos destinos de depuração quando o ADB confirmar a conexão." Margin="24,10,0,0" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Grid Margin="0,24,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="Serviços encontrados" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Atualizar" Padding="16,6" Command="{Binding AtualizarCommand}" IsEnabled="{Binding Disponivel}"
                  AutomationProperties.Name="Atualizar dispositivos e serviços" Style="{DynamicResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        </Grid>
        <TextBox Text="{Binding Filtro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"
                 AutomationProperties.Name="Buscar serviço por nome ou endereço" ToolTip="Buscar por nome ou endereço IP"
                 Style="{DynamicResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <ListView ItemsSource="{Binding Servicos}" MinHeight="96" MaxHeight="220" AutomationProperties.Name="Serviços ADB disponíveis">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Dispositivo" Width="150" DisplayMemberBinding="{Binding Nome}" />
              <GridViewColumn Header="ADB Wi-Fi" Width="85" DisplayMemberBinding="{Binding Versao}" />
              <GridViewColumn Header="API" Width="80" DisplayMemberBinding="{Binding Api}" />
              <GridViewColumn Header="Finalidade" Width="110" DisplayMemberBinding="{Binding Tipo}" />
              <GridViewColumn Header="IP e porta" Width="180" DisplayMemberBinding="{Binding Endereco}" />
              <GridViewColumn Header="Ação" Width="110">
                <GridViewColumn.CellTemplate><DataTemplate>
                  <Button Content="Selecionar" Padding="8,3" CommandParameter="{Binding Endereco}" ToolTip="{Binding Instancia}"
                          Command="{Binding DataContext.SelecionarCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                          Style="{DynamicResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
                </DataTemplate></GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
        <TextBlock Text="{Binding Descoberta}" TextWrapping="Wrap" Margin="0,10,0,20" Opacity="0.75" />
        <TextBlock Text="ADB Wi-Fi v1.0: os recursos disponíveis dependem do Android e do fabricante. O pareamento por código ou QR continua disponível. Metadados ausentes aparecem como não informados."
                   TextWrapping="Wrap" Margin="0,0,0,16" Opacity="0.7" />
        <TabControl>
          <TabItem Header="Parear com QR code">
            <StackPanel Margin="18">
              <TextBlock Text="Leia o QR code com a câmera de pareamento do Android" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="Opções do desenvolvedor → Depuração sem fio → Parear dispositivo com QR code" TextWrapping="Wrap" Margin="0,8,0,16" Opacity="0.75" />
              <Viewbox x:Name="QrVisual" Width="232" Height="232" Stretch="Uniform" AutomationProperties.Name="QR code temporário para pareamento ADB">
                <Canvas Width="{Binding Qr.Tamanho}" Height="{Binding Qr.Tamanho}" Background="White">
                  <Path Data="{Binding Qr.Geometria}" Fill="Black" RenderOptions.EdgeMode="Aliased" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="{Binding StatusQr}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,14" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" IsEnabled="{Binding Disponivel}">
                <Button Content="Gerar novo QR code" Command="{Binding GerarQrCommand}" Padding="14,7" Style="{DynamicResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
                <Button Content="Encerrar sessão" Command="{Binding CancelarQrCommand}" Margin="10,0,0,0" Padding="14,7" Style="{DynamicResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
              </StackPanel>
            </StackPanel>
          </TabItem>
          <TabItem Header="Parear com código">
            <StackPanel Margin="18" IsEnabled="{Binding Disponivel}">
              <TextBlock Text="Abra “Parear dispositivo com código de pareamento” no Android" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="Selecione um serviço de pareamento acima ou copie o IP e a porta mostrados nessa tela." TextWrapping="Wrap" Margin="0,8,0,18" Opacity="0.75" />
              <TextBlock Text="IP e porta de pareamento" Margin="0,0,0,6" />
              <TextBox Text="{Binding EnderecoPareamento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8" AutomationProperties.Name="Endereço de pareamento, por exemplo 192.168.1.10:37123" Style="{DynamicResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
              <TextBlock Text="Código de seis dígitos" Margin="0,14,0,6" />
              <TextBox Text="{Binding Codigo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Padding="8" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="Código temporário de seis dígitos" Style="{DynamicResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
              <Button Content="Parear dispositivo" Command="{Binding ParearCommand}" Padding="16,8" Margin="0,18,0,0" HorizontalAlignment="Left" Style="{DynamicResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
            </StackPanel>
          </TabItem>
          <TabItem Header="Conexão manual">
            <StackPanel Margin="18" IsEnabled="{Binding Disponivel}">
              <TextBlock Text="Conecte um dispositivo já pareado" FontWeight="SemiBold" />
              <TextBlock Text="Copie o IP e a porta da tela principal de Depuração sem fio. A porta de conexão é diferente da porta de pareamento." TextWrapping="Wrap" Margin="0,8,0,18" Opacity="0.75" />
              <TextBlock Text="IP e porta de conexão" Margin="0,0,0,6" />
              <TextBox Text="{Binding EnderecoConexao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8" AutomationProperties.Name="Endereço de conexão ADB" Style="{DynamicResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
              <Button Content="Conectar" Command="{Binding ConectarCommand}" Padding="16,8" Margin="0,18,0,0" HorizontalAlignment="Left" Style="{DynamicResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
              <Button Content="Desconectar este endereço" Command="{Binding DesconectarCommand}" Padding="16,8" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{DynamicResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
            </StackPanel>
          </TabItem>
        </TabControl>
        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,18,0,20">
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>
        <TextBlock Text="Dispositivos reconhecidos pelo ADB" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
        <ListView ItemsSource="{Binding Dispositivos}" MinHeight="70" MaxHeight="180" AutomationProperties.Name="Dispositivos e estado reportados pelo ADB">
          <ListView.View><GridView>
            <GridViewColumn Header="Modelo" Width="160" DisplayMemberBinding="{Binding Modelo}" />
            <GridViewColumn Header="Serial / endereço" Width="300" DisplayMemberBinding="{Binding Serial}" />
            <GridViewColumn Header="Estado ADB" Width="110" DisplayMemberBinding="{Binding Estado}" />
          </GridView></ListView.View>
        </ListView>
        <TextBlock Text="device = online • offline = sem comunicação • unauthorized = autorização pendente no aparelho" Margin="0,8,0,20" Opacity="0.7" TextWrapping="Wrap" />
        <Expander Header="Configuração do Android SDK e diagnóstico">
          <StackPanel Margin="0,12,0,0">
            <TextBlock Text="Caminho opcional para adb.exe (vazio = detectar automaticamente)" Margin="0,0,0,6" TextWrapping="Wrap" />
            <TextBox Text="{Binding CaminhoAdb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8" AutomationProperties.Name="Caminho opcional do executável ADB" Style="{DynamicResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
            <TextBlock Text="{Binding Resumo}" TextWrapping="Wrap" Margin="0,10,0,10" />
            <TextBlock Text="Sem descoberta? Confira o firewall e o multicast mDNS da rede. Redes de convidados podem isolar dispositivos. Não é necessário desativar o firewall: use o endereço manual quando o multicast estiver bloqueado." TextWrapping="Wrap" Opacity="0.75" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Border>
</DataTemplate>
